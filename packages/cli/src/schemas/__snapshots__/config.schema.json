{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "output": {
      "description": "An array of output types. These are run in the order they are specified.",
      "default": [
        "css"
      ],
      "type": "array",
      "items": {
        "anyOf": [
          {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "design-tokens",
                    "description": "The type of output file"
                  },
                  "dir": {
                    "default": "designsystemet/design-tokens",
                    "description": "The output directory",
                    "type": "string"
                  },
                  "cleanDir": {
                    "default": false,
                    "description": "Whether to delete the files in the output directory before generating files",
                    "type": "boolean"
                  }
                },
                "required": [
                  "type"
                ]
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "css",
                    "description": "The type of output file"
                  },
                  "dir": {
                    "default": "designsystemet",
                    "description": "The output directory",
                    "type": "string"
                  },
                  "cleanDir": {
                    "default": false,
                    "description": "Whether to delete the files in the output directory before generating files",
                    "type": "boolean"
                  },
                  "tokensDir": {
                    "description": "The directory containing the design tokens to build CSS from. Defaults to `dir` of the `design-tokens` output. If neither is set, CSS is created directly from the themes",
                    "type": "string"
                  },
                  "tailwind": {
                    "default": false,
                    "description": "The Tailwind CSS major version to generate a theme file for, or `false` to not generate one",
                    "anyOf": [
                      {
                        "type": "string",
                        "const": "v3"
                      },
                      {
                        "type": "string",
                        "const": "v4"
                      },
                      {
                        "type": "boolean",
                        "const": false
                      }
                    ]
                  }
                },
                "required": [
                  "type"
                ]
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "types",
                    "description": "The type of output file"
                  },
                  "dir": {
                    "default": "designsystemet",
                    "description": "The output directory",
                    "type": "string"
                  },
                  "cleanDir": {
                    "default": false,
                    "description": "Whether to delete the files in the output directory before generating files",
                    "type": "boolean"
                  },
                  "tokensDir": {
                    "description": "The directory containing the design tokens to build type declarations from. Defaults to `dir` of the `design-tokens` output. If neither is set, type declarations are created directly from the themes",
                    "type": "string"
                  }
                },
                "required": [
                  "type"
                ]
              }
            ],
            "description": "An object representing an output file"
          },
          {
            "type": "string",
            "enum": [
              "design-tokens",
              "css",
              "types"
            ],
            "description": "An output type using its default settings"
          }
        ],
        "description": "An output file, either as an object or an output type using its default settings."
      }
    },
    "outDir": {
      "default": "design-tokens",
      "deprecated": true,
      "description": "Deprecated: use `output[].dir` instead. Path to the output directory for the created design tokens",
      "type": "string"
    },
    "clean": {
      "default": false,
      "deprecated": true,
      "description": "Deprecated: use `output[].cleanDir` instead. Delete the output directory before creating tokens",
      "type": "boolean"
