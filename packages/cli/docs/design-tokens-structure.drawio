                <mxCell id="c2" value="Designsystemet design-tokens: structure" style="text;html=1;align=left;verticalAlign=middle;fontStyle=1;fontSize=18;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="700" height="30" as="geometry"/></mxCell>
        <mxCell id="c3" value="Left to right: the config is turned into token-set files, $themes.json groups the sets into Figma collections and modes, and the same sets are built to CSS. Placeholders: [theme] = theme name from the config, [color] = a color name." style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontColor=#555555;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="40" width="1180" height="40" as="geometry"/></mxCell>
        <mxCell id="c4" value="&lt;b&gt;designsystemet.config.json&lt;/b&gt;&lt;br&gt;&lt;br&gt;themes.[theme]&lt;br&gt;&amp;nbsp;&amp;nbsp;colors (neutral + custom)&lt;br&gt;&amp;nbsp;&amp;nbsp;typography.[set].fontFamily …&lt;br&gt;&amp;nbsp;&amp;nbsp;size (steps small/medium/large)&lt;br&gt;&amp;nbsp;&amp;nbsp;borderRadius (base, scale, steps)&lt;br&gt;&amp;nbsp;&amp;nbsp;border-width, shadow, opacity&lt;br&gt;&amp;nbsp;&amp;nbsp;overrides (colors, severity, …)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="40" y="330" width="240" height="170" as="geometry"/></mxCell>
