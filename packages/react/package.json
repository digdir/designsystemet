{
  "name": "@digdir/designsystemet-react",
  "type": "module",
  "version": "1.19.1",
  "description": "React components for Designsystemet",
  "author": "Designsystemet team",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/digdir/designsystemet.git"
  },
  "homepage": "https://github.com/digdir/designsystemet/tree/main/packages/react",
  "license": "MIT",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.cts",
        "default": "./dist/cjs/index.cjs"
      }
    },
    "./colors": {
      "types": "./dist/esm/colors.d.ts"
    },
    "./react-types": {
      "types": "./dist/esm/react-types.d.ts"
    }
  },
  "files": [
    "dist/**"
  ],
  "scripts": {
    "build": "pnpm run clean && vite build && vite build --mode cjs && vite build --mode cjs-dts",
    "clean": "rimraf dist",
    "types": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=18.3.1 || ^19.0.0",
    "react-dom": ">=18.3.1 || ^19.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@digdir/designsystemet-types": "workspace:",
    "@digdir/designsystemet-web": "workspace:",
    "@floating-ui/dom": "^1.8.0",
    "@floating-ui/react": "0.26.23",
    "@navikt/aksel-icons": "^8.16.1",
    "@radix-ui/react-slot": "^1.3.3",
    "@tanstack/react-virtual": "^3.14.9",
    "clsx": "^2.1.1"
  },
  "devDependencies": {
    "@digdir/designsystemet-css": "workspace:^",
    "@storybook/addon-docs": "10.5.7",
    "@storybook/addon-vitest": "10.5.7",
    "@storybook/react-vite": "10.5.7",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-dropzone": "19.3.0",
    "rimraf": "6.1.3",
    "rolldown-plugin-dts": "0.27.13",
    "storybook": "10.5.7",
    "typescript": "6.0.3",
    "vite": "8.2.1"
  }
}