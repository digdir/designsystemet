{
  "name": "@digdir/designsystemet-react",
  "type": "module",
  "version": "1.19.1",
  "description": "React components for Designsystemet",
  "author": "Designsystemet team",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/digdir/designsystemet.git"
  },
  "homepage": "https://github.com/digdir/designsystemet/tree/main/packages/react",
  "license": "MIT",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./colors": {
      "types": "./dist/types/colors.d.ts"
    },
    "./react-types": {
      "types": "./dist/react-types.d.ts"
    }
  },
  "files": [
    "dist/**"
  ],
  "scripts": {
    "build": "pnpm run clean && tsc -b tsconfig.lib.json --emitDeclarationOnly false && rollup -c --bundleConfigAsCjs",
    "clean": "rimraf dist && rimraf tsc-build && rimraf --glob \"*.tsbuildinfo\"",
    "types": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=18.3.1 || ^19.0.0",
    "react-dom": ">=18.3.1 || ^19.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@digdir/designsystemet-types": "workspace:",
    "@digdir/designsystemet-web": "workspace:",
    "@floating-ui/dom": "^1.8.0",
    "@floating-ui/react": "0.26.23",
    "@navikt/aksel-icons": "^8.16.1",
    "@radix-ui/react-slot": "^1.3.3",
    "@tanstack/react-virtual": "^3.14.9",
    "clsx": "^2.1.1"
  },
  "devDependencies": {
    "@digdir/designsystemet-css": "workspace:^",
    "@rollup/plugin-commonjs": "29.0.3",
    "@rollup/plugin-node-resolve": "16.0.3",
    "@storybook/addon-docs": "10.5.7",
    "@storybook/addon-vitest": "10.5.7",
    "@storybook/react-vite": "10.5.7",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "react-dropzone": "19.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "rimraf": "6.1.3",
    "rollup": "4.62.4",
    "rollup-plugin-copy": "3.5.0",
    "storybook": "10.5.7",
    "typescript": "6.0.3"
  }
}
