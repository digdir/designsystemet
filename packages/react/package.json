{
  "name": "@digdir/designsystemet-react",
  "type": "module",
  "version": "1.24.0",
  "description": "React components for Designsystemet",
  "author": "Designsystemet team",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/digdir/designsystemet.git"
  },
  "homepage": "https://github.com/digdir/designsystemet/tree/main/packages/react",
  "license": "MIT",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.cts",
        "default": "./dist/cjs/index.cjs"
      }
    },
    "./colors": {
      "types": "./dist/esm/colors.d.ts"
    },
    "./react-types": {
      "types": "./dist/esm/react-types.d.ts"
    }
  },
  "files": [
    "dist/**"
  ],
  "scripts": {
    "build": "tsdown",
    "types": "tsc --build --noEmit"
  },
  "peerDependencies": {
    "react": ">=18.3.1 || ^19.0.0",
    "react-dom": ">=18.3.1 || ^19.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@digdir/designsystemet-types": "workspace:*",
    "@digdir/designsystemet-web": "workspace:*",
    "@floating-ui/dom": "^1.8.0",
    "@floating-ui/react": "0.26.23",
    "@radix-ui/react-slot": "^1.5.0",
    "@tanstack/react-virtual": "^3.14.26",
    "clsx": "^2.1.1"
  },
  "devDependencies": {
    "@digdir/designsystemet-css": "workspace:^",
    "@navikt/aksel-icons": "^8.22.1",
    "@storybook/addon-docs": "10.6.6",
    "@storybook/addon-vitest": "10.6.6",
    "@storybook/react-vite": "10.6.6",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.9",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-dropzone": "20.2.0",
    "storybook": "10.6.6",
    "tsdown": "0.23.7",
    "typescript": "6.0.3"
  }
}