{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "../../",
    "composite": true,
    "noEmit": false,
    "emitDeclarationOnly": true,
    "types": [
      "./declarations.d.ts",
      "./react-types.d.ts",
      "../css/theme/types.d.ts",
      "../../apps/storybook/story-utils/type-extensions.d.ts",
    ]
  },
  "include": [
    "stories",
    "src",
    "../../apps/storybook/.storybook/**/*.ts*",
    "../../apps/storybook/story-utils/**/*.ts*",
    "../../designsystemet.config.json"
  ],
  "exclude": ["src/**/*.test.ts*", "src/**/*.mdx"]
}
