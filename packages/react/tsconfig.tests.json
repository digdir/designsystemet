{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "./src",
    "allowSyntheticDefaultImports": true,
    "composite": true,
    "noEmit": false,
    "emitDeclarationOnly": true,
    "types": [
      "@testing-library/jest-dom",
      "vitest/globals",
      "./declarations.d.ts",
      "./react-types.d.ts"
    ]
  },
  "include": ["src"],
  "exclude": ["src/**/*.stories.ts*", "src/**/*.chromatic.ts*", "src/**/*.mdx"]
}
