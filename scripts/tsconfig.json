{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    // The scripts are run with Node as they are, which strips the types. So they import each
    // other with `.ts`, and only use syntax that can be stripped.
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "lib": ["es2023"],
    "types": ["node"],
    "incremental": false,
    "declaration": false,
    "sourceMap": false
  },
  "include": ["*.ts"]
}
